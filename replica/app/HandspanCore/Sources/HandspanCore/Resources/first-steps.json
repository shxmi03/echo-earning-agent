    {
      "id": "bf772433-e1a6-506e-92cc-6ef59543e75f",
      "title": "Steps on the staff",
      "summary": "Read where each note sits before you play it.",
      "kind": "concept",
      "minutes": 6,
      "concept": {
        "title": "Lines and spaces",
        "paragraphs": [
          "Each line and each space of the staff is one white key. Moving from a line to the next space is one step up the keyboard.",
          "When the next note is one step higher, the next finger plays it. When it is two steps higher, a finger is skipped.",
          "Read the next note while you play the current one. That habit is most of sight reading."
        ],
        "keys": [
          60,
          62,
          64
        ],
        "tip": null
      },
