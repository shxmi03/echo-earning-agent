  "id": "d4d397f6-e393-5d7e-a830-239b9a8c6949",
  "title": "First steps",
  "isFree": true,
  "contentVersion": 2,
  "summary": "Find your way around the keys, read your first notes and play five-note tunes with your right hand.",
  "lessons": [
    {
      "id": "a0709ee4-87f0-5519-a787-e7004b828ec9",
      "title": "Find middle C",
      "summary": "Find your way around the keys by their black-key groups, then play your first note.",
      "kind": "concept",
      "minutes": 5,
      "concept": {
        "title": "The black keys are your map",
        "paragraphs": [
          "The black keys come in groups of two and three, all the way up the piano. That pattern is how pianists find any note without looking for labels.",
          "C is the white key just to the left of every group of two black keys.",
          "Middle C is the C nearest the middle of your piano. On most pianos it sits close to the maker's name. On the staff it gets its own short line, just below the five lines."
        ],
        "keys": [
          60
        ],
        "tip": "Sit so your elbows are level with the keys and your feet are flat on the floor."
      },
      "exercises": [
        {
          "id": "33fd84ec-8fa6-5ec1-8fc5-f09cf08e81d7",
          "prompt": "Play middle C with your right thumb.",
          "clef": "treble",
