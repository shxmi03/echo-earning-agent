{
 "_about": "Themes for the piano-learning app recon. Generic themes from the replica pack, tuned (performance no longer matches 'slow', which here means lesson pace), plus piano-specific ones at the top. Patterns are case-insensitive Python regexes.",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b"
 ],
 "themes": [
  {
   "id": "recognition",
   "label": "Note recognition misses or rejects correct notes",
   "kind": "complaint",
   "patterns": [
    "\\bdoesn'?t hear\\b",
    "\\bcan'?t hear\\b",
    "\\bhearing\\b",
    "\\bdeaf\\b",
    "\\brecogni[sz]",
    "\\bdetect",
