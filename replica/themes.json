    "\\bsays? (i'?m|it'?s|that i'?m) (not|wrong)",
    "\\bnot playing the keys\\b",
    "\\bwon'?t read\\b",
    "\\bdoesn'?t (read|register|work)\\b.*\\b(key|note)",
    "\\bmicrophone\\b",
    "\\bwrong octave\\b",
    "\\bmax volume\\b",
    "\\bwhen i do the keys\\b"
   ]
  },
  {
